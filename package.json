{
  "name": "@nico0713520/dsh-tui",
  "version": "0.2.0",
  "description": "A lightweight, calm TUI built on the original DeepSeek Harness ACP flow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nico0713520/dsh-tui.git"
  },
  "homepage": "https://github.com/Nico0713520/dsh-tui#readme",
  "bugs": {
    "url": "https://github.com/Nico0713520/dsh-tui/issues"
  },
  "preferGlobal": true,
  "bin": {
    "dsh-tui": "bin/dsh-tui.js"
  },
  "files": [
    "bin",
    "dist",
    "config",
    "assets/brand",
    "README.md",
    "README.zh-CN.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests scripts",
    "test": "node scripts/ensure-pty-helper.mjs && vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:pty": "node scripts/ensure-pty-helper.mjs && vitest run tests/pty",
    "check:source": "npm run lint && npm run typecheck && npm run test && npm run build",
    "publint": "publint",
    "pack:check": "node scripts/check-pack.mjs",
    "install:check": "node scripts/check-install.mjs",
    "release-assets:check": "node scripts/check-release-assets.mjs",
    "composition:check": "node scripts/check-composition.mjs",
    "compat:check": "node scripts/check-dsh-compat.mjs",
    "check": "npm run check:source && npm run compat:check && npm run composition:check && npm run publint && npm run pack:check",
    "prepack": "npm run check:source"
  },
  "keywords": [
    "deepseek",
    "harness",
    "acp",
    "tui",
    "terminal"
  ],
  "author": "nico0713520",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-acp-demo": "0.1.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.1.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.1-rc.2",
    "@deepseek-ai/dsh-bash-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs-observation-policy": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.1-rc.2",
    "@deepseek-ai/dsh-pwsh-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-pwsh-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.1-rc.2",
    "@deepseek-ai/dsh-shell-env": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-pwsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-todo": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.1-rc.2",
    "@earendil-works/pi-tui": "0.84.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "node-pty": "1.1.0",
    "oxlint": "1.76.0",
    "publint": "0.3.21",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
