    "@types/node": "22.20.0",
    "node-pty": "1.1.0",
    "oxlint": "1.76.0",
    "publint": "0.3.21",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
